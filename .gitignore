# 3D scene assets — too large for git, hosted on R2 instead.
# Keep scene.json, floorplan.png, audio, mediapipe wasm; exclude splat blobs.
*.ply
*.spz
*.sog
public/assets/scenes/sample/splat.*
public/assets/scenes/**/splat.*
public/assets/scenes/**/collision/*.glb

# R2 upload staging — large bin assets we hand-upload to object storage
r2-uploads/**/splat.*
r2-uploads/**/*.ply
r2-uploads/**/*.spz
r2-uploads/**/*.sog

