{
  // Cloudflare Workers + Static Assets config.
  // Used by `npx wrangler deploy` to ship the Vite build output (./dist) as a
  // static site backed by Workers' built-in asset handler. SPA fallback sends
  // any unmatched URL to index.html so client-side routes like
  // `/#/viewer/<id>` keep working when users hit refresh.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cg-gaussian",
  "compatibility_date": "2026-05-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
